# ================================================
# CIRMS - Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your values
# ================================================

# ─── Backend: Server ────────────────────────────
SERVER_PORT=8080

# ─── Backend: Aiven MySQL Database ──────────────
DATABASE_HOST=your-service.aivencloud.com
DATABASE_PORT=3306
DATABASE_NAME=cirms_db
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=your-aiven-password
DB_USE_SSL=true

# ─── Backend: Security & JWT ────────────────────
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ─── Backend: Admin Seed Account ────────────────
ADMIN_EMAIL=admin@cirms.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_NAME=System Administrator

# ─── Backend: File Uploads (local dev fallback) ─
FILE_UPLOAD_LOCATION=./uploads

# ─── Backend: Cloudinary (production uploads) ───
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Get from: https://console.cloudinary.com
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── Backend: CORS ──────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (Vercel env variable) ─────────────
# Set this to your Render backend URL after deployment
# e.g. https://cirms-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api
